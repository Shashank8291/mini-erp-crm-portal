# ==============================================================================
# Mini ERP + CRM Operations Portal - Master Environment Configuration
# ==============================================================================
# Copy this file to '.env' at the project root for Docker Compose and unified configuration,
# or copy into 'backend/.env' and 'frontend/.env' for individual standalone development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Note: The backend includes an automated fallback to in-memory PostgreSQL (pg-mem)
# if PostgreSQL is not installed or unreachable locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mini_erp_crm
DB_USER=postgres
DB_PASSWORD=postgres

# PostgreSQL Container Configuration (Used by docker-compose.yml)
POSTGRES_DB=mini_erp_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (Express.js + TypeScript)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JSON Web Token (JWT) Security
# WARNING: Change JWT_SECRET to a strong, random key in production!
JWT_SECRET=mini_erp_crm_super_secret_jwt_key_2024
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (React 19 + Vite)
# ------------------------------------------------------------------------------
# In local development: http://localhost:5000/api
# In production (e.g., Netlify with redirect proxy): /api
# In Docker: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 4. SERVERLESS / NETLIFY DEPLOYMENT (Optional)
# ------------------------------------------------------------------------------
# When deployed to Netlify Functions, these are auto-detected by backend/src/config/db.ts
# NETLIFY=true

